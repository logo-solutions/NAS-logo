#!/bin/bash
# Assigne owner + storage_path + permissions selon le sous-dossier consume
set -euo pipefail

PAPERLESS_URL="http://localhost:8000"
API_TOKEN="{{ paperless_api_token }}"
CONSUME_DIR="/usr/src/paperless/consume"

# Extraire le premier niveau de sous-dossier
REL_PATH="${DOCUMENT_SOURCE_PATH#${CONSUME_DIR}/}"
SUBFOLDER=$(echo "$REL_PATH" | cut -d'/' -f1)

# Mapping sous-dossier → username + privé
USERNAME=""
PRIVATE="false"
case "$SUBFOLDER" in
{% for folder, cfg in paperless_consume_users.items() %}
  {{ folder }}) USERNAME="{{ cfg.username }}"; PRIVATE="{{ cfg.private | lower }}" ;;
{% endfor %}
  *) exit 0 ;;
esac

# Résoudre l'ID utilisateur
USER_RESPONSE=$(curl -sf -H "Authorization: Token ${API_TOKEN}" \
  "${PAPERLESS_URL}/api/users/?username=${USERNAME}")
USER_ID=$(echo "$USER_RESPONSE" | jq -r '.results[0].id // empty')

if [ -z "$USER_ID" ]; then
  echo "post-consume: utilisateur ${USERNAME} introuvable" >&2
  exit 1
fi

# Résoudre l'ID du storage path
SP_RESPONSE=$(curl -sf -H "Authorization: Token ${API_TOKEN}" \
  "${PAPERLESS_URL}/api/storage_paths/?name=${SUBFOLDER}")
SP_ID=$(echo "$SP_RESPONSE" | jq -r '.results[0].id // empty')

# Permissions vides = privé (seul le owner voit le document)
PERMS='{"view":{"users":[],"groups":[]},"change":{"users":[],"groups":[]}}'

# Construire le payload
if [ -n "$SP_ID" ]; then
  PAYLOAD="{\"owner\": ${USER_ID}, \"storage_path\": ${SP_ID}, \"set_permissions\": ${PERMS}}"
else
  PAYLOAD="{\"owner\": ${USER_ID}, \"set_permissions\": ${PERMS}}"
fi

curl -sf -X PATCH \
  -H "Authorization: Token ${API_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" \
  "${PAPERLESS_URL}/api/documents/${DOCUMENT_ID}/" > /dev/null

echo "post-consume: doc ${DOCUMENT_ID} (${SUBFOLDER}) → owner=${USERNAME} sp=${SP_ID:-none} privé=${PRIVATE}"
