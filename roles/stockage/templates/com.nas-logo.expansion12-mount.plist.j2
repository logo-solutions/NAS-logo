<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nas-logo.expansion12-mount</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/nas-logo-expansion12-mount.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>~/Library/Logs/nas-logo/expansion12-mount.log</string>
  <key>StandardErrorPath</key>
  <string>~/Library/Logs/nas-logo/expansion12-mount.err</string>
  <key>StartInterval</key>
  <integer>30</integer>
</dict>
</plist>
