# docker-compose monitoring NAS-logo — généré par Ansible

name: monitoring

services:
  prometheus:
    container_name: prometheus
    image: prom/prometheus:latest
    volumes:
      - {{ monitoring_data_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ monitoring_data_dir }}/prometheus/rules:/etc/prometheus/rules:ro
      - {{ monitoring_data_dir }}/prometheus:/prometheus
    ports:
      - {{ prometheus_port }}:9090
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.retention.time=30d"
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: always

  grafana:
    container_name: grafana
    image: grafana/grafana:latest
    volumes:
      - {{ monitoring_data_dir }}/grafana:/var/lib/grafana
    ports:
      - {{ grafana_port }}:3000
    environment:
      GF_SECURITY_ADMIN_PASSWORD: {{ vault_grafana_admin_password }}
      GF_INSTALL_PLUGINS: grafana-clock-panel
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: always
    depends_on:
      - prometheus

  cadvisor:
    container_name: cadvisor
    image: gcr.io/cadvisor/cadvisor:latest
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
    ports:
      - {{ cadvisor_port }}:8080
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8080/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: always

  node-exporter:
    container_name: node_exporter
    image: prom/node-exporter:latest
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:9100/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: always

  ntfy:
    container_name: ntfy
    image: binwiederhier/ntfy:latest
    command: serve
    volumes:
      - {{ monitoring_data_dir }}/ntfy:/var/lib/ntfy
    ports:
      - {{ ntfy_port }}:80
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:80/v1/health"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: always
