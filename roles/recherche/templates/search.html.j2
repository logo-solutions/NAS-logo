<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NAS-logo — Recherche</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0f0f13;
      color: #e0e0e8;
      min-height: 100vh;
      padding: 2rem 1rem;
    }
    header { text-align: center; margin-bottom: 2rem; }
    header h1 { font-size: 1.4rem; font-weight: 600; color: #8080b0; letter-spacing: 0.05em; }

    #search-box {
      display: flex;
      max-width: 680px;
      margin: 0 auto 1.2rem;
      background: #1a1a24;
      border: 1px solid #2a2a3a;
      border-radius: 12px;
      overflow: hidden;
      transition: border-color 0.2s;
    }
    #search-box:focus-within { border-color: #5555aa; }
    #q {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #e0e0e8;
      font-size: 1.05rem;
      padding: 0.85rem 1.2rem;
    }
    #q::placeholder { color: #404060; }
    #clear {
      background: none; border: none; color: #404060;
      padding: 0 1rem; cursor: pointer; font-size: 1.1rem; display: none;
    }
    #clear:hover { color: #a0a0c0; }

    #filters {
      display: flex; gap: 0.5rem; max-width: 680px;
      margin: 0 auto 1.5rem; flex-wrap: wrap;
    }
    .filter-btn {
      background: #1a1a24; border: 1px solid #2a2a3a; color: #606080;
      border-radius: 20px; padding: 0.3rem 0.9rem; font-size: 0.82rem;
      cursor: pointer; transition: all 0.2s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: #22223a; border-color: #5555aa; color: #c0c0e8;
    }

    #stats { max-width: 680px; margin: 0 auto 1rem; font-size: 0.78rem; color: #404060; }

    #results { max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.6rem; }

    .card {
      background: #1a1a24; border: 1px solid #252535;
      border-radius: 10px; padding: 0.9rem 1.1rem;
      text-decoration: none; color: inherit; display: block;
      transition: border-color 0.15s, background 0.15s;
    }
    .card:hover { border-color: #4444aa; background: #1d1d2d; }
    .card-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; }
    .card-icon { font-size: 1rem; flex-shrink: 0; }
    .card-title {
      font-weight: 500; font-size: 0.92rem; color: #d0d0f0;
      flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .card-title mark, .card-preview mark {
      background: #3a3800; color: #ffe044;
      border-radius: 2px; padding: 0 2px;
    }
    .card-badge {
      font-size: 0.68rem; padding: 0.12rem 0.5rem;
      border-radius: 10px; font-weight: 500; flex-shrink: 0;
    }
    .badge-Paperless  { background: #0e2a0e; color: #55bb55; }
    .badge-Fichiers   { background: #2a1e0a; color: #cc9944; }

    .card-preview {
      font-size: 0.8rem; color: #707080; line-height: 1.5;
      display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .card-date { font-size: 0.72rem; color: #383858; margin-top: 0.35rem; }

    #empty { text-align: center; color: #383858; padding: 3rem; display: none; font-size: 0.9rem; }
  </style>
</head>
<body>
  <header><h1>🏠 NAS-logo</h1></header>

  <div id="search-box">
    <input type="search" id="q" placeholder="Rechercher dans documents et notes…" autocomplete="off" autofocus>
    <button id="clear" onclick="clearSearch()">✕</button>
  </div>

  <div id="filters">
    <button class="filter-btn active" data-filter="">Tout</button>
    <button class="filter-btn" data-filter="document">📄 Documents</button>
    <button class="filter-btn" data-filter="note">📝 Notes</button>
  </div>

  <div id="stats"></div>
  <div id="results"></div>
  <div id="empty">Aucun résultat</div>

  <script>
    const MEILI = 'http://{{ nas_ip }}:{{ meilisearch_port }}';
    const KEY   = '{{ meilisearch_master_key }}';
    const INDEX = 'nas-logo';
    const ICONS = { document: '📄', note: '📝' };

    let currentFilter = '', debounceTimer = null;

    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter;
        doSearch();
      });
    });

    document.getElementById('q').addEventListener('input', e => {
      document.getElementById('clear').style.display = e.target.value ? 'block' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(doSearch, 200);
    });

    function clearSearch() {
      document.getElementById('q').value = '';
      document.getElementById('clear').style.display = 'none';
      doSearch();
    }

    async function doSearch() {
      const q = document.getElementById('q').value.trim();
      const body = {
        q, limit: 30,
        attributesToHighlight: ['title', 'preview'],
        highlightPreTag: '<mark>', highlightPostTag: '</mark>',
        attributesToCrop: ['preview'], cropLength: 80,
      };
      if (currentFilter) body.filter = `type = "${currentFilter}"`;

      try {
        const resp = await fetch(`${MEILI}/indexes/${INDEX}/search`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${KEY}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        renderResults(await resp.json());
      } catch(e) {
        document.getElementById('stats').textContent = 'Erreur de connexion à Meilisearch';
      }
    }

    function renderResults(data) {
      const hits = data.hits || [];
      const stats = document.getElementById('stats');
      const results = document.getElementById('results');
      const empty = document.getElementById('empty');

      stats.textContent = hits.length ? `${data.estimatedTotalHits ?? hits.length} résultats` : '';

      if (!hits.length) {
        results.innerHTML = '';
        empty.style.display = document.getElementById('q').value ? 'block' : 'none';
        return;
      }
      empty.style.display = 'none';

      results.innerHTML = hits.map(hit => {
        const hl = hit._formatted || hit;
        const icon = ICONS[hit.type] || '📁';
        const badgeClass = `badge-${hit.source}`;
        const date = hit.date ? new Date(hit.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
        return `
          <a class="card" href="${hit.url}" target="_blank">
            <div class="card-header">
              <span class="card-icon">${icon}</span>
              <span class="card-title">${hl.title || hit.title}</span>
              <span class="card-badge ${badgeClass}">${hit.source}</span>
            </div>
            ${hl.preview ? `<div class="card-preview">${hl.preview}</div>` : ''}
            ${date ? `<div class="card-date">${date}</div>` : ''}
          </a>`;
      }).join('');
    }

    doSearch();
  </script>
</body>
</html>
