#!/bin/bash
# restore.sh — restauration depuis Hetzner Storage Box (chiffré rclone)
# Généré par Ansible (NAS-logo)
#
# Usage :
#   nas-logo-restore.sh                  → restaure depuis current (dernier backup)
#   nas-logo-restore.sh --list           → liste les versions disponibles
#   nas-logo-restore.sh --version 20260413  → restaure depuis une version spécifique
#   nas-logo-restore.sh --dry-run        → simule sans écrire
set -euo pipefail

RCLONE=/opt/homebrew/bin/rclone
DOCKER=/opt/homebrew/bin/docker
DOCKER_HOST="unix:///Users/{{ mac_user }}/.colima/default/docker.sock"
export DOCKER_HOST

SSD="{{ ssd_mount_point }}"
BACKUP_DIR="{{ backup_dir }}"
NTFY_URL="http://localhost:{{ ntfy_port }}/{{ ntfy_topic }}"
LOG_DIR="$HOME/Library/Logs/nas-logo"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/restore.log"

VERSION="current"
DRY_RUN=false

notify() {
  local title="$1" msg="$2" priority="${3:-default}"
  curl -s -H "Title: $title" -H "Priority: $priority" -d "$msg" "$NTFY_URL" || true
}

usage() {
  grep '^#' "$0" | grep -v '#!/' | sed 's/^# //'
  exit 0
}

# ── Parsing arguments ───────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --list)
      echo "==> Versions disponibles sur Hetzner :"
      $RCLONE lsd hetzner-crypt:versions 2>/dev/null | awk '{print $NF}' | sort -r
      echo ""
      echo "==> Dernière sauvegarde (current) :"
      $RCLONE lsl hetzner-crypt:current --max-depth 1 2>/dev/null | tail -5
      exit 0
      ;;
    --version)
      VERSION="$2"; shift ;;
    --dry-run)
      DRY_RUN=true ;;
    --help|-h)
      usage ;;
    *)
      echo "Option inconnue : $1" >&2; exit 1 ;;
  esac
  shift
done

# ── Sécurité ────────────────────────────────────────────────────────────────
if [[ "$VERSION" == "current" ]]; then
  REMOTE="hetzner-crypt:current"
else
  REMOTE="hetzner-crypt:versions/${VERSION}"
  # Vérifier que la version existe
  if ! $RCLONE lsd hetzner-crypt:versions 2>/dev/null | grep -q "$VERSION"; then
    echo "ERREUR : version '$VERSION' introuvable sur Hetzner." >&2
    echo "Utilisez --list pour voir les versions disponibles." >&2
    exit 1
  fi
fi

echo "==> Restauration NAS-logo démarrée ($(date))" | tee "$LOG_FILE"
echo "==> Source  : $REMOTE" | tee -a "$LOG_FILE"
echo "==> Cible   : $SSD" | tee -a "$LOG_FILE"
[[ "$DRY_RUN" == "true" ]] && echo "==> MODE DRY-RUN — aucune écriture" | tee -a "$LOG_FILE"

notify "NAS-logo Restore démarré" "Restauration depuis $REMOTE vers $SSD." "default"

# ── 1. Arrêt des services ────────────────────────────────────────────────────
echo "==> Arrêt des conteneurs Immich..." | tee -a "$LOG_FILE"
if [[ "$DRY_RUN" == "false" ]]; then
  $DOCKER stop immich_server immich_machine_learning immich_redis immich_postgres || true
fi
echo "==> Arrêt des conteneurs Paperless..." | tee -a "$LOG_FILE"
if [[ "$DRY_RUN" == "false" ]]; then
  $DOCKER stop paperless paperless_db paperless_redis || true
fi
echo "==> Arrêt des conteneurs n8n..." | tee -a "$LOG_FILE"
if [[ "$DRY_RUN" == "false" ]]; then
  $DOCKER stop n8n n8n_db || true
fi

# ── 2. Restauration des fichiers depuis Hetzner ─────────────────────────────
echo "==> Restauration des fichiers (rclone sync)..." | tee -a "$LOG_FILE"
RCLONE_ARGS=(
  --log-level INFO
  --log-file "$LOG_FILE"
  --exclude "backups/**"
)
[[ "$DRY_RUN" == "true" ]] && RCLONE_ARGS+=(--dry-run)

$RCLONE sync "$REMOTE" "$SSD" "${RCLONE_ARGS[@]}"

# ── 3. Restauration de la base PostgreSQL ───────────────────────────────────
echo "==> Recherche du dump PostgreSQL le plus récent..." | tee -a "$LOG_FILE"
LATEST_DUMP=$(ls -t "$BACKUP_DIR"/immich-db-*.sql.gz 2>/dev/null | head -1 || true)

if [[ -z "$LATEST_DUMP" ]]; then
  echo "AVERTISSEMENT : aucun dump PostgreSQL trouvé dans $BACKUP_DIR." | tee -a "$LOG_FILE"
  echo "==> Redémarrage Immich sans restauration DB..." | tee -a "$LOG_FILE"
else
  echo "==> Dump trouvé : $LATEST_DUMP" | tee -a "$LOG_FILE"

  if [[ "$DRY_RUN" == "false" ]]; then
    echo "==> Suppression du répertoire PostgreSQL (réinitialisation propre)..." | tee -a "$LOG_FILE"
    rm -rf "{{ ssd_mount_point }}/immich-db"
    echo "==> Démarrage PostgreSQL seul..." | tee -a "$LOG_FILE"
    $DOCKER compose -f ~/immich/docker-compose.yml up -d database 2>&1 | tee -a "$LOG_FILE"
    echo "==> Attente PostgreSQL prêt..." | tee -a "$LOG_FILE"
    for i in $(seq 1 30); do
      STATUS=$($DOCKER inspect --format='{% raw %}{{.State.Status}}{% endraw %}' immich_postgres 2>/dev/null || echo "unknown")
      if [[ "$STATUS" == "running" ]]; then
        $DOCKER exec immich_postgres pg_isready -U immich &>/dev/null && break
      fi
      sleep 2
    done

    echo "==> Restauration PostgreSQL..." | tee -a "$LOG_FILE"
    gunzip -c "$LATEST_DUMP" | $DOCKER exec -i immich_postgres psql \
      --username=immich \
      --dbname=immich \
      2>&1 | tee -a "$LOG_FILE"
  else
    echo "==> [dry-run] Restaurerait : $LATEST_DUMP" | tee -a "$LOG_FILE"
  fi
fi

# ── 4. Restauration Paperless ────────────────────────────────────────────────
echo "==> Recherche du dump Paperless le plus récent..." | tee -a "$LOG_FILE"
PAPERLESS_DUMP=$(ls -t "$BACKUP_DIR"/paperless-db-*.sql.gz 2>/dev/null | head -1 || true)

if [[ -z "$PAPERLESS_DUMP" ]]; then
  echo "AVERTISSEMENT : aucun dump Paperless trouvé dans $BACKUP_DIR." | tee -a "$LOG_FILE"
else
  echo "==> Dump Paperless trouvé : $PAPERLESS_DUMP" | tee -a "$LOG_FILE"
  if [[ "$DRY_RUN" == "false" ]]; then
    echo "==> Démarrage PostgreSQL Paperless seul..." | tee -a "$LOG_FILE"
    $DOCKER start paperless_db 2>&1 | tee -a "$LOG_FILE"
    echo "==> Attente PostgreSQL Paperless prêt..." | tee -a "$LOG_FILE"
    for i in $(seq 1 30); do
      STATUS=$($DOCKER inspect --format='{% raw %}{{.State.Status}}{% endraw %}' paperless_db 2>/dev/null || echo "unknown")
      if [[ "$STATUS" == "running" ]]; then
        $DOCKER exec paperless_db pg_isready -U paperless &>/dev/null && break
      fi
      sleep 2
    done
    echo "==> Restauration PostgreSQL Paperless..." | tee -a "$LOG_FILE"
    gunzip -c "$PAPERLESS_DUMP" | $DOCKER exec -i paperless_db psql \
      --username={{ paperless_db_user }} \
      --dbname={{ paperless_db_name }} \
      2>&1 | tee -a "$LOG_FILE"
  else
    echo "==> [dry-run] Restaurerait Paperless : $PAPERLESS_DUMP" | tee -a "$LOG_FILE"
  fi
fi

# ── 5. Restauration n8n ──────────────────────────────────────────────────────
echo "==> Recherche du dump n8n le plus récent..." | tee -a "$LOG_FILE"
N8N_DUMP=$(ls -t "$BACKUP_DIR"/n8n-db-*.sql.gz 2>/dev/null | head -1 || true)

if [[ -z "$N8N_DUMP" ]]; then
  echo "AVERTISSEMENT : aucun dump n8n trouvé dans $BACKUP_DIR." | tee -a "$LOG_FILE"
else
  echo "==> Dump n8n trouvé : $N8N_DUMP" | tee -a "$LOG_FILE"
  if [[ "$DRY_RUN" == "false" ]]; then
    echo "==> Démarrage PostgreSQL n8n seul..." | tee -a "$LOG_FILE"
    $DOCKER start n8n_db 2>&1 | tee -a "$LOG_FILE"
    echo "==> Attente PostgreSQL n8n prêt..." | tee -a "$LOG_FILE"
    for i in $(seq 1 30); do
      STATUS=$($DOCKER inspect --format='{% raw %}{{.State.Status}}{% endraw %}' n8n_db 2>/dev/null || echo "unknown")
      if [[ "$STATUS" == "running" ]]; then
        $DOCKER exec n8n_db pg_isready -U n8n &>/dev/null && break
      fi
      sleep 2
    done
    echo "==> Restauration PostgreSQL n8n..." | tee -a "$LOG_FILE"
    gunzip -c "$N8N_DUMP" | $DOCKER exec -i n8n_db psql \
      --username=n8n \
      --dbname=n8n \
      2>&1 | tee -a "$LOG_FILE"
  else
    echo "==> [dry-run] Restaurerait n8n : $N8N_DUMP" | tee -a "$LOG_FILE"
  fi
fi

# ── 6. Redémarrage des services ───────────────────────────────────────────────
echo "==> Redémarrage des conteneurs Immich..." | tee -a "$LOG_FILE"
if [[ "$DRY_RUN" == "false" ]]; then
  $DOCKER start immich_postgres immich_redis immich_machine_learning immich_server 2>&1 | tee -a "$LOG_FILE"
fi
echo "==> Redémarrage des conteneurs Paperless..." | tee -a "$LOG_FILE"
if [[ "$DRY_RUN" == "false" ]]; then
  $DOCKER start paperless_redis paperless paperless_db 2>&1 | tee -a "$LOG_FILE"
fi
echo "==> Redémarrage des conteneurs n8n..." | tee -a "$LOG_FILE"
if [[ "$DRY_RUN" == "false" ]]; then
  $DOCKER start n8n 2>&1 | tee -a "$LOG_FILE"
fi

echo "==> Restauration terminée ($(date))" | tee -a "$LOG_FILE"
notify "NAS-logo Restore OK" "Restauration terminée depuis $REMOTE. Voir $LOG_FILE." "low"
