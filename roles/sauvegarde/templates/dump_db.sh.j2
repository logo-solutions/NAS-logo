#!/bin/bash
# dump_db.sh — dump PostgreSQL Immich + Paperless via docker exec
# Généré par Ansible (NAS-logo)
set -euo pipefail

BACKUP_DIR="{{ backup_dir }}"
DOCKER_HOST="{{ docker_host }}"
export DOCKER_HOST

# ── Immich ──────────────────────────────────────────────────────────────────
IMMICH_DUMP="$BACKUP_DIR/immich-db-$(date +%Y%m%d-%H%M%S).sql.gz"
echo "==> Dump PostgreSQL Immich..." >&2
{{ docker_bin }} exec immich_postgres pg_dumpall \
  --clean \
  --if-exists \
  --username={{ immich_db_user }} \
  | gzip > "$IMMICH_DUMP"
echo "==> Dump écrit : $IMMICH_DUMP" >&2

# ── Paperless ────────────────────────────────────────────────────────────────
PAPERLESS_DUMP="$BACKUP_DIR/paperless-db-$(date +%Y%m%d-%H%M%S).sql.gz"
echo "==> Dump PostgreSQL Paperless..." >&2
{{ docker_bin }} exec paperless_db pg_dump \
  --clean \
  --if-exists \
  --username={{ paperless_db_user }} \
  {{ paperless_db_name }} \
  | gzip > "$PAPERLESS_DUMP"
echo "==> Dump écrit : $PAPERLESS_DUMP" >&2

# ── Nettoyage local (> 3 jours) ──────────────────────────────────────────────
find "$BACKUP_DIR" -name "immich-db-*.sql.gz" -mtime +3 -delete
find "$BACKUP_DIR" -name "paperless-db-*.sql.gz" -mtime +3 -delete
echo "==> Nettoyage dumps locaux terminé" >&2
