#!/bin/bash
# roles/sauvegarde/templates/dump_db.sh.j2
# Dump PostgreSQL Immich avec rotation

set -euo pipefail

DATE=$(date +%Y-%m-%d)
DUMP_DIR="{{ hetzner_backup_dir }}/db"
DUMP_FILE="${DUMP_DIR}/immich-db-${DATE}.sql.gz"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Dump PostgreSQL..."

docker exec immich_postgres pg_dump -U immich immich | gzip > "$DUMP_FILE"

# Rotation — garder {{ backup_daily_keep }} dumps
ls -t "$DUMP_DIR"/*.sql.gz | tail -n +$(( {{ backup_daily_keep }} + 1 )) | xargs rm -f

# Copier vers Hetzner
rclone copy "$DUMP_FILE" hetzner:{{ hetzner_remote_path }}/db/ --checksum

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Dump terminé : $DUMP_FILE"
