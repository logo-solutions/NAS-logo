#!/bin/bash
# backup.sh — dump DB + sync rclone vers Hetzner chiffré
# Généré par Ansible (NAS-logo)
set -euo pipefail

NTFY_URL="http://localhost:{{ ntfy_port }}/{{ ntfy_topic }}"
LOG_DIR="$HOME/Library/Logs/nas-logo"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/backup.log"

notify() {
  local title="$1" msg="$2" priority="${3:-default}"
  curl -s -H "Title: $title" -H "Priority: $priority" -d "$msg" "$NTFY_URL" || true
}

# Mode maintenance : créer /tmp/nas-logo-maintenance pour suspendre les sauvegardes
if [ -f /tmp/nas-logo-maintenance ]; then
  echo "==> Mode maintenance actif — sauvegarde ignorée ($(date))" | tee "$LOG_FILE" >&2
  exit 0
fi

echo "==> Sauvegarde NAS-logo démarrée ($(date))" | tee "$LOG_FILE" >&2

# 1. Dump PostgreSQL
echo "==> Dump base de données..." | tee -a "$LOG_FILE" >&2
if ! /usr/local/bin/nas-logo-dump-db.sh 2>&1 | tee -a "$LOG_FILE"; then
  notify "NAS-logo Dump DB échoué" "Le dump PostgreSQL a échoué — sauvegarde annulée. Voir $LOG_FILE." "urgent"
  exit 1
fi

# 2. Sync vers Hetzner chiffré — SSD (DB, index, monitoring)
echo "==> Sync SSD vers Hetzner..." | tee -a "$LOG_FILE" >&2
/opt/homebrew/bin/rclone sync "{{ ssd_mount_point }}" hetzner-crypt:current/ssd \
  --backup-dir "hetzner-crypt:versions/$(date +%Y%m%d)/ssd" \
  --log-level INFO \
  --log-file "$LOG_FILE" \
  --min-age 5m

# 3. Sync vers Hetzner — données critiques HDD (paperless, personnes, files)
# Immich exclu : volumeux et origine Google Photos conservée
echo "==> Sync données critiques HDD vers Hetzner..." | tee -a "$LOG_FILE" >&2
for subdir in paperless personnes files; do
  src="{{ hdd_nas_volume }}/${subdir}"
  if [ -d "$src" ]; then
    /opt/homebrew/bin/rclone sync "$src" "hetzner-crypt:current/hdd/${subdir}" \
      --backup-dir "hetzner-crypt:versions/$(date +%Y%m%d)/hdd/${subdir}" \
      --log-level INFO \
      --log-file "$LOG_FILE" \
      --min-age 5m
  fi
done

# 3. Rétention : purger les anciennes versions
echo "==> Application de la rétention..." | tee -a "$LOG_FILE" >&2
/opt/homebrew/bin/rclone delete hetzner-crypt:versions \
  --min-age {{ backup_daily_keep }}d \
  --log-level INFO \
  --log-file "$LOG_FILE" || true

echo "==> Sauvegarde terminée ($(date))" | tee -a "$LOG_FILE" >&2
notify "NAS-logo Sauvegarde OK" "Sauvegarde terminée avec succès. Voir $LOG_FILE." "low"
