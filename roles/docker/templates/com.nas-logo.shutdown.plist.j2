<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nas-logo.shutdown</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/nas-logo-shutdown.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ExitTimeout</key>
  <integer>120</integer>
  <key>StandardOutPath</key>
  <string>/tmp/nas-logo-shutdown.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nas-logo-shutdown.err</string>
</dict>
</plist>
