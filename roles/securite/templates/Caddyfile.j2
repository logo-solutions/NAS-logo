# roles/securite/templates/Caddyfile.j2
# Généré par Ansible — ne pas éditer manuellement
# Reverse proxy Immich accessible uniquement via Tailscale

{{ caddy_domain }} {
    reverse_proxy localhost:{{ immich_port }}

    # En-têtes de sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Logs d'accès
    log {
        output file {{ ansible_env.HOME }}/immich/logs/caddy-access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }

    # Compression
    encode gzip

    # Limite de taille pour les uploads (photos / vidéos)
    request_body {
        max_size 10GB
    }
}
