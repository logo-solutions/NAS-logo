<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nas-logo.tailscale</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/nas-logo-tailscale-start.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Volumes/NAS-LOGO-DATA/journaux/tailscale-start.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/NAS-LOGO-DATA/journaux/tailscale-start.err</string>
</dict>
</plist>
