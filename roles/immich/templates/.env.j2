# Immich .env — généré par Ansible (NAS-logo)

IMMICH_VERSION={{ immich_version }}

DB_DATABASE_NAME={{ immich_db_name }}
DB_USERNAME={{ immich_db_user }}
DB_PASSWORD={{ immich_db_password }}
DB_DATA_LOCATION={{ immich_db_dir }}

{% if use_nfs -%}
# NFS optimization: /mnt/photos mounted dans Colima
UPLOAD_LOCATION={{ nfs_mount_path }}/NAS-LOGO-VOLUME/personnes/loic-perso/immich
{% else -%}
# Fallback: bind mount direct macOS (virtiofs)
UPLOAD_LOCATION={{ immich_data_dir }}
{% endif %}

IMMICH_HOST=0.0.0.0