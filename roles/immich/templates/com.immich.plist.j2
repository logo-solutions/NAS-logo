<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- roles/immich/templates/com.immich.plist.j2 -->
<!-- Généré par Ansible — redémarre Immich automatiquement au login -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.immich.startup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd {{ immich_install_dir }} &amp;&amp; /usr/local/bin/docker compose up -d</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>{{ ansible_env.HOME }}/immich/logs/startup.log</string>

  <key>StandardErrorPath</key>
  <string>{{ ansible_env.HOME }}/immich/logs/startup-error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
