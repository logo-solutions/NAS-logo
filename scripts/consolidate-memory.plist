<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.logo.consolidate-nas-memory</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/logousb/SSD/Projects/NAS-logo/scripts/consolidate-memory.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/consolidate-nas-memory.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/consolidate-nas-memory.err</string>

  <!-- Ne tourne pas si le disque SSD n'est pas monté -->
  <key>WatchPaths</key>
  <array>
    <string>/Volumes/logousb</string>
  </array>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
